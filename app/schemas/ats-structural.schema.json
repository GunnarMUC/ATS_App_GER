{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATSStructuralReport",
  "type": "object",
  "required": ["schema_version", "score_hint", "issues"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "score_hint": { "type": "integer", "minimum": 0, "maximum": 100 },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message_de"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "table_layout",
              "multi_column",
              "image_or_photo",
              "text_in_image",
              "header_contact_only",
              "tiny_font",
              "textboxes",
              "missing_contact"
            ]
          },
          "severity": { "type": "string", "enum": ["block", "warn", "info"] },
          "message_de": { "type": "string" }
        }
      }
    },
    "notes_de": { "type": "array", "items": { "type": "string" } }
  }
}
